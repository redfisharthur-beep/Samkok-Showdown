{
  "name": "samkok-showdown",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "src/worker.js",
  "vars": {
    "APP_ORIGIN": "https://samkok-showdown.redfisharthur.workers.dev",
    "LINE_CHANNEL_ID": "2011852042"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "Accounts"
      },
      {
        "name": "MATCHES",
        "class_name": "Match"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Accounts",
        "Match"
      ]
    }
  ]
}
